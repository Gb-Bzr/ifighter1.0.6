; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Mecha Zangief"        ;Name of character
displayname = "Zangief" ;Name of character to display
;versiondate =    ;Version date of character
;mugenversion =   ;Version of M.U.G.E.N character works on
author = "One Winged Angel"      ;Character author name
pal.defaults = 1, 10, 4   ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Mz.cmd   ;Command set
cns     = Mz.cns   ;Constants
st      = Mz.cns   ;States
stcommon = Common.cns ;Common states
sprite  = Mz.sff   ;Sprite
anim    = Mz.air   ;Animation
sound  = Mz.snd   ;Sound
ai	= Mz.ai
pal1   = Mvc-1.act   ;Palettes (can have up to 12)
pal2   = MshvSf-2.act 
pal3   = Alpha1.act
pal4   = Mvc-2.act 
pal5   = MshvSf-1.act
pal6   = Alpha1.act
pal7   = Mvc2-4.act
pal8   = Mvc2-5.act
pal9   = Mvc2-6.act
pal10  = Mvc2-1.act
pal11  = Mvc2-2.act
pal12  = Mvc2-3.act
