[State 255, VelSet]
type = VelSet
triggerall = Enemy, PalNo >= 7
trigger1 = AnimElem = 1, = 9
x = -1
y = -5
[State 255, VelSet]
type = VelSet
triggerall = Enemy, PalNo <= 6
trigger1 = AnimElem = 1, = 12
x = -1
y = -5
[State 255, VelAdd]
type = VelAdd
trigger1 = AnimElem = 1, >= 13
y = .66

[State 255, SelfState]
type = SelfState
trigger1 = Time > 15
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 5201

